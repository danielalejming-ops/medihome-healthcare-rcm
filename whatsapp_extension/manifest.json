{
  "manifest_version": 3,
  "name": "MediHome - Asistente Lisa WhatsApp Web",
  "version": "5.4",
  "description": "Asistente médico virtual Lisa con IA Multimodal y Piloto Automático 24/7 para WhatsApp Web oficial de MediHome Valencia",
  "permissions": ["storage"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["lisa_bot.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["interceptor.js"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}
